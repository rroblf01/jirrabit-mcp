# ---------------------------------------------------------------------------
# jirrabit-mcp configuration. Copy to `.env` and fill in.
#
# Every setting is read from the environment. There is no config file.
#
# The only strict rule: JIRRABIT_URL and JIRRABIT_API_KEY must be set together
# or not at all. One without the other is a startup error, because a URL with no
# key can only ever mean "use a key I was not given".
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# OPTIONAL default instance.
#
# Leave BOTH unset for a shared server: every caller then names its own instance
# with the instanceUrl and apiKey tool arguments, which is what you want when
# several people connect to the same jirrabit-mcp to reach their own jirrabit.
#
# Set BOTH for a personal single-instance server, so callers can omit the
# arguments. Loopback and private addresses are fine here — this is the
# operator's own choice — but they are refused when a *caller* supplies them.
#
#   jirrabit in the same compose network:  http://web:8000
#   jirrabit on the host, containerised:   http://host.docker.internal:8000
#   jirrabit on a domain:                  https://jirrabit.example.com
# ---------------------------------------------------------------------------
JIRRABIT_URL=
JIRRABIT_API_KEY=

# --- optional ---------------------------------------------------------------

# Per-request timeout in seconds. Default 30.
JIRRABIT_TIMEOUT=30

# Retries for transport errors and 502/503/504. Default 2. A 429 or any other
# 4xx is never retried: it is a decision, not a hiccup.
JIRRABIT_MAX_RETRIES=2

# Register the destructive tools (deleteJiraIssue, deleteJiraComment,
# deleteJiraIssueAttachment). Off by default. jirrabit's own permission checks
# still apply, so this only controls tool visibility, not authorisation.
JIRRABIT_MCP_ENABLE_DELETE=false

# Register the project-administration tools (createJiraProject,
# updateJiraProject). Off by default, for the same reason.
JIRRABIT_MCP_ENABLE_MANAGE=false

# Address for `-transport http`. Default :8082.
JIRRABIT_MCP_ADDR=:8082

# MCP endpoint path for `-transport http`. Default /mcp.
JIRRABIT_MCP_PATH=/mcp
