# ---------------------------------------------------------------------------
# jirrabit-mcp configuration. Copy to `.env` and fill in.
#
# Every setting is read from the environment. There is no config file and no
# default that silently points somewhere: a missing JIRRABIT_URL or
# JIRRABIT_API_KEY is a startup error, not a fallback.
# ---------------------------------------------------------------------------

# Base URL of the jirrabit instance. No trailing slash.
#
#   jirrabit in the same docker-compose network:  http://web:8000
#   jirrabit on the host, containerised MCP:      http://host.docker.internal:8000
#   jirrabit published on a domain:               https://jirrabit.example.com
JIRRABIT_URL=http://localhost:8000

# API key from jirrabit's "API keys" page (accounts -> profile -> API keys).
# Sent as `Authorization: Bearer <key>` on every request. jirrabit stores only
# the SHA-256 of this value, so it cannot be recovered once discarded.
JIRRABIT_API_KEY=

# --- optional ---------------------------------------------------------------

# Per-request timeout in seconds. Default 30.
JIRRABIT_TIMEOUT=30

# Retries for transport errors and 502/503/504. Default 2. A 429 or any other
# 4xx is never retried: it is a decision, not a hiccup.
JIRRABIT_MAX_RETRIES=2

# Register the destructive tools (deleteJiraIssue, deleteJiraComment,
# deleteJiraIssueAttachment). Off by default. jirrabit's own permission checks
# still apply, so this only controls tool visibility, not authorisation.
JIRRABIT_MCP_ENABLE_DELETE=false

# Register the project-administration tools (createJiraProject,
# updateJiraProject). Off by default, for the same reason.
JIRRABIT_MCP_ENABLE_MANAGE=false

# Address for `-transport http`. Default :8082.
JIRRABIT_MCP_ADDR=:8082

# MCP endpoint path for `-transport http`. Default /mcp.
JIRRABIT_MCP_PATH=/mcp
